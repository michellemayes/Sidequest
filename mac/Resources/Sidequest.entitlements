<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sidequest.app under the hardened runtime. Not sandboxed: it runs git, terminals and agents. -->
<plist version="1.0">
<dict>
    <!-- Driving iTerm2 and Terminal, and quitting Slack to relaunch it, over AppleScript. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
